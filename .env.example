# ============================================================================
# AI Infrastructure Investment Intelligence (AI3) — Environment Configuration
# Copy this file to .env and populate keys as needed.
# The application runs 100% functionally WITHOUT any paid API or AI keys.
# ============================================================================

# Database Configuration (defaults to local SQLite in data_store/ai3.db)
DATABASE_URL=sqlite:///data_store/ai3.db

# Data Mode: HYBRID (default: live free + cached seed), LIVE_ONLY, or OFFLINE_SEED
AI3_DATA_MODE=HYBRID

# Optional Market Data Provider Keys (leave blank for free NSE/BSE/yfinance adapters)
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Optional AI Research Layer Keys (leave blank for deterministic rule-based mode)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Privacy & Security Settings
AI3_LOCAL_AI_ONLY=false
AI3_ALLOW_PORTFOLIO_AI_SHARING=false
AI3_HTTP_TIMEOUT_SECONDS=15
AI3_STALE_PRICE_DAYS=5
AI3_STALE_FUNDAMENTALS_DAYS=120

# Optional Alert Email Settings (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
